---
import footerContent from "../config/footer.json";

const { footer } = footerContent;
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__inner site-footer__top-inner">
      <div class="site-footer__info">
        <div class="site-footer__item">
          <svg
            class="site-footer__icon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5Z" />
          </svg>

          <div class="site-footer__text">
            <strong>{footer.address.title}</strong>
            <p>{footer.address.text}</p>
          </div>
        </div>

        <div class="site-footer__item">
          <svg
            class="site-footer__icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="M4 7l8 6 8-6" />
          </svg>

          <div class="site-footer__text">
            <strong>{footer.email.primary}</strong>
            <p>{footer.email.secondary}</p>
          </div>
        </div>

        <div class="site-footer__item">
          <svg
            class="site-footer__icon"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M6.62 10.79a15.053 15.053 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.11.37 2.31.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.3 21 3 13.7 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.27.2 2.47.57 3.58a1 1 0 0 1-.24 1.01l-2.21 2.2Z" />
          </svg>

          <div class="site-footer__text">
            <strong>{footer.phone.number}</strong>
            <p>{footer.phone.schedule}</p>
          </div>
        </div>
      </div>

      <div class="site-footer__social">
        <a
          href={footer.social.youtube}
          class="site-footer__social-link site-footer__social-link--youtube"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
        >
          <svg class="site-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23 12s0-3.46-.44-5.13a2.8 2.8 0 0 0-1.97-1.97C18.92 4.46 12 4.46 12 4.46s-6.92 0-8.59.44a2.8 2.8 0 0 0-1.97 1.97C1 8.54 1 12 1 12s0 3.46.44 5.13a2.8 2.8 0 0 0 1.97 1.97c1.67.44 8.59.44 8.59.44s6.92 0 8.59-.44a2.8 2.8 0 0 0 1.97-1.97C23 15.46 23 12 23 12ZM10 15.5v-7l6 3.5-6 3.5Z" />
          </svg>
        </a>

        <a
          href={footer.social.facebook}
          class="site-footer__social-link site-footer__social-link--facebook"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg class="site-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.5 22v-8h2.7l.4-3h-3.1V9.1c0-.87.24-1.46 1.49-1.46H16.7V5a24.7 24.7 0 0 0-2.5-.13c-2.47 0-4.16 1.5-4.16 4.27V11H7.2v3h2.84v8h3.46Z" />
          </svg>
        </a>

        <a
          href={footer.social.instagram}
          class="site-footer__social-link site-footer__social-link--instagram"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg class="site-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>

        <a
          href={footer.social.email}
          class="site-footer__social-link site-footer__social-link--email"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Correo"
        >
          <svg class="site-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5" />
            <path d="M4 7l8 6 8-6" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__inner site-footer__bottom-inner">
      <div class="site-footer__copyright">
        <p>{footer.copyright.line1}</p>
        <p>{footer.copyright.line2}</p>
        <span class="site-footer__credits-icon"></span>
      </div>
    </div>
  </div>
</footer>