---
import NextSectionButton from "./NextSectionButton.astro";
import MultilineText from "./MultilineText.astro";

type Variant = "standard" | "split" | "final";

interface Props {
  id: string;
  title: string;
  description?: string;
  bullets?: string[];
  image?: string;
  imageAlt?: string;
  imageSecondary?: string;
  imageSecondaryAlt?: string;
  variant?: Variant;
  reverse?: boolean;
  nextTarget?: string | null;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  id,
  title,
  description = "",
  bullets = [],
  image = "",
  imageAlt = "",
  imageSecondary = "",
  imageSecondaryAlt = "",
  variant = "standard",
  reverse = false,
  nextTarget = null,
  ctaLabel = "",
  ctaHref = "#"
} = Astro.props;

---

<section id={id} class="section-sheet info-section">
  <div class="site-shell">
    {variant === "split" ? (
      <div class="info-section__split">
        <div class="info-section__split-left">
          <h2 class="info-section__title">
            <MultilineText text={title} />
          </h2>

          {description && (
            <p class="info-section__description">{description}</p>
          )}

          {image && (
            <img
              src={image}
              alt={imageAlt}
              class="info-section__image info-section__image--emoji"
            />
          )}

          {bullets.length > 0 && (
            <ul class="info-section__list">
              {bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </div>

        <div class="info-section__split-right">
          {imageSecondary && (
            <img
              src={imageSecondary}
              alt={imageSecondaryAlt}
              class="info-section__image info-section__image--reviews"
            />
          )}
        </div>
      </div>
    ) : variant === "final" ? (
      <div class="info-section__final">
        <div class="info-section__final-left">
          {image && (
            <img
              src={image}
              alt={imageAlt}
              class="info-section__image info-section__image--final-left"
            />
          )}
        </div>

        <div class="info-section__final-right">
          <h2 class="info-section__title">
            <MultilineText text={title} />
          </h2>

          {ctaLabel && (
            <a href={ctaHref} class="primary-cta">
              {ctaLabel}
            </a>
          )}

          {description && (
            <p class="info-section__description">{description}</p>
          )}

          {imageSecondary && (
            <img
              src={imageSecondary}
              alt={imageSecondaryAlt}
              class="info-section__image info-section__image--final-right"
            />
          )}
        </div>
      </div>
    ) : (
      <div
        class:list={[
          "info-section__grid",
          reverse && "info-section__grid--reverse"
        ]}
      >
        <div class="info-section__media">
          {image && (
            <img
              src={image}
              alt={imageAlt}
              class="info-section__image"
            />
          )}
        </div>

        <div class="info-section__content">
          <h2 class="info-section__title">
            <MultilineText text={title} />
          </h2>

          {description && (
            <p class="info-section__description">{description}</p>
          )}

          {bullets.length > 0 && (
            <ul class="info-section__list">
              {bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    )}

    {nextTarget && (
      <div class="info-section__next">
        <NextSectionButton target={nextTarget} />
      </div>
    )}
  </div>
</section>
