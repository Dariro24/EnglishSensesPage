---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/not-found.css";

const characterImage = "/media/home/hero/hero-personaje.webp";
---

<MainLayout
  title="Página no encontrada | English Senses"
  description="La página que buscas no existe o el enlace ya no está disponible. Vuelve al inicio de English Senses para seguir navegando."
  canonicalPath="/404"
  robots="noindex, nofollow"
>
  <section class="not-found-page" aria-labelledby="not-found-title">
    <div class="site-shell not-found-shell">
      <div class="not-found-copy">
        <p class="not-found-kicker">Error 404</p>
        <h1 id="not-found-title" class="not-found-title">
          ¡Ups! Parece que te perdiste
        </h1>
        <p class="not-found-subtitle">
          La página que buscas no existe o el enlace ya no está disponible.
        </p>
        <p class="not-found-text">
          Pero tranquilo, puedes volver al inicio y seguir explorando English
          Senses.
        </p>

        <div class="not-found-actions" aria-label="Acciones de ayuda">
          <a class="not-found-button not-found-button--primary" href="/">
            Volver al inicio
          </a>
        </div>
      </div>

      <div class="not-found-media" aria-hidden="true">
        <img
          class="not-found-image"
          src={characterImage}
          alt=""
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>
</MainLayout>
