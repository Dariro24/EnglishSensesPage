---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";
import NextSectionButton from "../components/NextSectionButton.astro";
import MultilineText from "../components/MultilineText.astro";
import mideTuInglesContent from "../config/pages/mide-tu-ingles.json";
import "../styles/mide-tu-ingles.css";

const { hero, levelButtons, levelsA, levelsB, benefits } = mideTuInglesContent;
const levelA1 = levelsA.groups[0];
const levelA2 = levelsA.groups[1];
const levelA1Id = "nivel-a1";
const levelA2Id = "nivel-a2";
const levelButtonA1 = levelButtons[0];
const levelButtonA2 = levelButtons[1];
const levelButtonB1 = levelButtons[2];
const decorativeArrow = "/media/home/hero/arrow.webp";
---

<MainLayout title="Mide tu inglés" showFooter={false}>
  <section id="mide-tu-ingles-hero" class="test-section test-section--hero">
    <div class="site-shell test-hero">
      <div class="test-hero__content">
        <h1 class="test-hero__title">
          <MultilineText text={hero.title} />
        </h1>

        <p class="test-hero__intro">{hero.intro}</p>

        <h2 class="test-hero__subtitle">{hero.subtitle}</h2>

        <ul class="test-hero__list">
          {hero.bullets.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="test-hero__media">
        <img
          src={hero.image}
          alt={hero.imageAlt}
          class="test-hero__image"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="test-section__next test-section__next--desktop">
      <NextSectionButton target={`#${levelsA.id}`} />
    </div>

    <div class="test-section__next test-section__next--mobile-tablet">
      <NextSectionButton target={`#${levelA1Id}`} />
    </div>
  </section>

  <section id={levelsA.id} class="test-section test-section--levels-a">
    <div class="site-shell test-levels-a">
      <div class="test-levels-a__left">
        <h2 class="test-levels-a__title">
          <MultilineText text={levelsA.title} />
        </h2>

        <p class="test-levels-a__intro">{levelsA.intro}</p>

        <p class="test-levels-a__selector-text">{levelsA.selectorText}</p>

        <div class="test-level-buttons test-level-buttons--vertical">
          {
            levelButtons.map((button) => (
              <a
                href={button.href.trim()}
                class="test-level-button"
                target="_blank"
                rel="noopener noreferrer"
              >
                {button.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="test-levels-a__right">
        <h2 class="test-levels-a__group-title">{levelsA.groupTitle}</h2>

        {
          levelsA.groups.map((group) => (
            <div class="test-level-group">
              <h3 class="test-level-group__heading">{group.heading}</h3>
              <ul class="test-level-group__list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="test-section__next">
      <NextSectionButton target={`#${levelsB.id}`} />
    </div>
  </section>

  <section id={levelA1Id} class="test-section test-section--level-a1">
    <div class="site-shell test-level-single">
      <div class="test-level-single__intro">
        <h2 class="test-levels-a__title">
          <MultilineText text={levelsA.title} />
        </h2>

        <p class="test-levels-a__intro">{levelsA.intro}</p>
      </div>

      <div class="test-level-group">
        <h3 class="test-level-group__heading">{levelA1.heading}</h3>
        <ul class="test-level-group__list">
          {levelA1.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <p class="test-level-single__selector-text">{levelsA.selectorText}</p>

      <img
        src={decorativeArrow}
        alt=""
        class="test-level-decorative-arrow"
        aria-hidden="true"
      />

      <div class="test-level-single__button-wrap">
        <a
          href={levelButtonA1.href.trim()}
          class="test-level-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          {levelButtonA1.label}
        </a>
      </div>
    </div>

    <div class="test-section__next">
      <NextSectionButton target={`#${levelA2Id}`} />
    </div>
  </section>

  <section id={levelA2Id} class="test-section test-section--level-a2">
    <div class="site-shell test-level-single">
      <div class="test-level-group">
        <h3 class="test-level-group__heading">{levelA2.heading}</h3>
        <ul class="test-level-group__list">
          {levelA2.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>

      <p class="test-level-single__selector-text">{levelsA.selectorText}</p>

      <img
        src={decorativeArrow}
        alt=""
        class="test-level-decorative-arrow"
        aria-hidden="true"
      />

      <div class="test-level-single__button-wrap">
        <a
          href={levelButtonA2.href.trim()}
          class="test-level-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          {levelButtonA2.label}
        </a>
      </div>
    </div>

    <div class="test-section__next">
      <NextSectionButton target={`#${levelsB.id}`} />
    </div>
  </section>

  <section id={levelsB.id} class="test-section test-section--levels-b">
    <div class="site-shell test-levels-b">
      <div class="test-levels-b__top">
        <h2 class="test-levels-b__title">{levelsB.title}</h2>
        <p class="test-levels-b__intro">{levelsB.intro}</p>
      </div>

      <div class="test-levels-b__grid">
        {
          levelsB.groups.map((group) => (
            <div class="test-level-group">
              <h3 class="test-level-group__heading">{group.heading}</h3>
              <ul class="test-level-group__list">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="test-levels-b__bottom">
        <p class="test-levels-b__selector-text">{levelsB.selectorText}</p>

        <img
          src={decorativeArrow}
          alt=""
          class="test-level-decorative-arrow"
          aria-hidden="true"
        />

        <div class="test-level-buttons test-level-buttons--horizontal test-level-buttons--desktop">
          {
            levelButtons.map((button) => (
              <a
                href={button.href.trim()}
                class="test-level-button"
                target="_blank"
                rel="noopener noreferrer"
              >
                {button.label}
              </a>
            ))
          }
        </div>

        <div class="test-level-buttons test-level-buttons--horizontal test-level-buttons--mobile">
          <a
            href={levelButtonB1.href.trim()}
            class="test-level-button"
            target="_blank"
            rel="noopener noreferrer"
          >
            {levelButtonB1.label}
          </a>
        </div>

        <p class="test-levels-b__cta-text">{levelsB.ctaText}</p>
        <p class="test-levels-b__note">{levelsB.note}</p>
      </div>
    </div>

    <div class="test-section__next">
      <NextSectionButton target={`#${benefits.id}`} />
    </div>
  </section>

  <section id={benefits.id} class="test-section test-section--benefits-final">
    <div class="site-shell test-benefits-final__shell">
      <div class="test-benefits-final">
        <div class="test-benefits-final__left">
          <img
            src={benefits.image}
            alt={benefits.imageAlt}
            class="test-benefits-final__image"
            loading="lazy"
            decoding="async"
          />

          <p class="test-benefits-final__selector-text test-benefits-final__selector-text--levels">
            {benefits.selectorText}
          </p>

          <div class="test-level-buttons test-level-buttons--horizontal test-benefits-final__level-buttons">
            {
              levelButtons.map((button) => (
                <a
                  href={button.href.trim()}
                  class="test-level-button"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {button.label}
                </a>
              ))
            }
          </div>
        </div>

        <div class="test-benefits-final__right">
          <h2 class="test-benefits-final__title">
            <MultilineText text={benefits.title} />
          </h2>

          <ul class="test-benefits-final__list">
            {benefits.bullets.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="test-section__footer">
      <Footer />
    </div>
  </section>

  <script>
    import "../scripts/section-scroll";
  </script>
</MainLayout>
