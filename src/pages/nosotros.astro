---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";
import NextSectionButton from "../components/NextSectionButton.astro";
import "../styles/nosotros.css";
import nosotrosContent from "../config/pages/nosotros.json";

const { intro, sections } = nosotrosContent;
const firstSection = sections[0];
const lastSection = sections[sections.length - 1];
const visionScrollTargetId = "mision-vision-scroll";
const motivaMobileId = "que-nos-motiva";
const hacemosMobileId = "como-lo-hacemos";
---

<MainLayout title="Nosotros" showFooter={false}>
  <section id="nosotros-intro" class="nosotros-section nosotros-section--intro">
    <div class="site-shell">
      <div class="nosotros-intro">
        <div class="nosotros-intro__content">
          <h1 class="nosotros-intro__title">{intro.title}</h1>

          <div class="nosotros-intro__text nosotros-copy--desktop">
            {intro.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <div class="nosotros-intro__text nosotros-copy--mobile-tablet">
            {(intro.mobileParagraphs ?? intro.paragraphs).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <div class="nosotros-intro__media">
          <img
            src={intro.image}
            alt={intro.imageAlt}
            class="nosotros-intro__image"
          />
        </div>
      </div>

      <div class="nosotros-section__next nosotros-section__next--desktop">
        <NextSectionButton target={`#${firstSection.id}`} />
      </div>

      <div class="nosotros-section__next nosotros-section__next--mobile-tablet">
        <NextSectionButton target={`#${motivaMobileId}`} />
      </div>
    </div>
  </section>

  <section id={firstSection.id} class="nosotros-section nosotros-section--dual">
  <div class="site-shell">
    <div class="nosotros-dual">

      <!-- Fila 1 izquierda: imagen estudiante -->
      <img
        src={firstSection.left.image}
        alt={firstSection.left.imageAlt}
        class="nosotros-dual__image--student"
      />

      <!-- Fila 1 derecha: ¿Qué nos motiva? -->
      <div class="nosotros-dual__block--motiva">
        <h2 class="nosotros-dual__title">{firstSection.right.title}</h2>
        <div class="nosotros-dual__text">
          {firstSection.right.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <!-- Fila 2 izquierda: ¿Cómo lo Hacemos? -->
      <div class="nosotros-dual__block--hacemos">
        <h2 class="nosotros-dual__title">{firstSection.left.title}</h2>
        <div class="nosotros-dual__text">
          {firstSection.left.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <!-- Fila 2 derecha: imagen puzzle -->
      <img
        src={firstSection.right.image}
        alt={firstSection.right.imageAlt}
        class="nosotros-dual__image--puzzle"
      />

    </div>

    <div class="nosotros-section__next">
      <NextSectionButton target={`#${visionScrollTargetId}`} />
    </div>
  </div>
</section>

  <section
    id={motivaMobileId}
    class="nosotros-section nosotros-section--mobile-split nosotros-section--motiva-mobile"
  >
    <div class="site-shell">
      <div class="nosotros-mobile-split">
        <h2 class="nosotros-mobile-split__title">{firstSection.right.title}</h2>

        <div class="nosotros-mobile-split__media">
          <img
            src={firstSection.right.image}
            alt={firstSection.right.imageAlt}
            class="nosotros-mobile-split__image"
          />
        </div>

        <div class="nosotros-mobile-split__text">
          {firstSection.right.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <div class="nosotros-section__next">
        <NextSectionButton target={`#${hacemosMobileId}`} />
      </div>
    </div>
  </section>

  <section
    id={hacemosMobileId}
    class="nosotros-section nosotros-section--mobile-split nosotros-section--hacemos-mobile"
  >
    <div class="site-shell">
      <div class="nosotros-mobile-split">
        <h2 class="nosotros-mobile-split__title">{firstSection.left.title}</h2>

        <div class="nosotros-mobile-split__media">
          <img
            src={firstSection.left.image}
            alt={firstSection.left.imageAlt}
            class="nosotros-mobile-split__image"
          />
        </div>

        <div class="nosotros-mobile-split__text">
          {firstSection.left.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <div class="nosotros-section__next">
        <NextSectionButton target={`#${visionScrollTargetId}`} />
      </div>
    </div>
  </section>

  <section id={lastSection.id} class="nosotros-section nosotros-section--vision">
    <span
      id={visionScrollTargetId}
      class="nosotros-scroll-target"
      aria-hidden="true"
    ></span>

    <div class="site-shell nosotros-vision__shell">
      <div class="nosotros-vision">
        <div class="nosotros-vision__media">
          <img
            src={lastSection.image}
            alt={lastSection.imageAlt}
            class="nosotros-vision__image"
          />
        </div>

        <div class="nosotros-vision__content">
          <h2 class="nosotros-vision__title">{lastSection.title}</h2>
          <p class="nosotros-vision__statement">{lastSection.statement}</p>
        </div>
      </div>
    </div>

    <div class="nosotros-section__footer">
      <Footer />
    </div>
  </section>

  <script>
    import "../scripts/section-scroll";
  </script>
</MainLayout>
