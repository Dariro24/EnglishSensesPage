---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/home.css";
import siteContent from "../config/site.json";
import homeContent from "../config/pages/home.json";
import NextSectionButton from "../components/NextSectionButton.astro";
import SectionSheet from "../components/SectionSheet.astro";
import MultilineText from "../components/MultilineText.astro";

const { links } = siteContent;
const { home, sections } = homeContent;

const regularSections = sections.slice(0, -1);
const finalSection = sections[sections.length - 1];
---

<MainLayout title="Inicio" showFooter={true}>
  <section id="home" class="home-hero section-sheet">
    <div class="site-shell home-hero__inner">
      <div class="home-hero__character-wrap">
        <picture>
          <source
            media="(max-width: 991px)"
            srcset={home.heroCharacterResponsive ?? home.heroCharacter}
          />
          <img
            src={home.heroCharacter}
            alt="Personaje principal"
            class="home-hero__character"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>

      <div class="home-hero__message-wrap">
        <img
          src={home.messageImage}
          alt={home.messageAlt}
          class="home-hero__message-image"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="home-hero__arrow-wrap" aria-hidden="true">
        <img
          src={home.arrowGif}
          alt=""
          class="home-hero__arrow-gif"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="home-hero__cta-wrap">
        <a href={links.inscribeteAhora} class="primary-cta">
          {home.primaryButtonLabel}
        </a>
      </div>

      <p class="home-hero__description">{home.description}</p>

      <div class="home-hero__actions">
        <NextSectionButton target="#rompe-barreras" />
      </div>
    </div>
  </section>

  {regularSections.map((section, index) => {
    const nextTarget =
      index < regularSections.length - 1
        ? `#${regularSections[index + 1].id}`
        : `#${finalSection.id}`;

    const variant =
      section.imagePosition === "split"
        ? "split"
        : section.imagePosition === "final"
          ? "final"
          : "standard";

    const reverse = section.imagePosition === "right";

    return (
      <SectionSheet
        id={section.id}
        title={section.title}
        description={section.description}
        bullets={section.bullets}
        image={section.image}
        imageAlt={section.imageAlt}
        imageSecondary={section.imageSecondary}
        imageSecondaryAlt={section.imageSecondaryAlt}
        variant={variant}
        reverse={reverse}
        nextTarget={nextTarget}
        ctaLabel={variant === "final" ? home.primaryButtonLabel : ""}
        ctaHref={variant === "final" ? links.inscribeteAhora : "#"}
      />
    );
  })}

  <section id={finalSection.id} class="section-sheet section-sheet--final">
    <div class="site-shell section-sheet__final-shell">
      <div class="info-section__final">
        <div class="info-section__final-left">
          <img
            src={finalSection.image}
            alt={finalSection.imageAlt}
            class="info-section__image info-section__image--final-left"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="info-section__final-right">
          <h2 class="info-section__title">
            <MultilineText text={finalSection.title} />
          </h2>

          <a href={links.inscribeteAhora} class="primary-cta">
            {home.primaryButtonLabel}
          </a>

          <p class="info-section__description">
            {finalSection.description}
          </p>

          <img
            src={finalSection.imageSecondary}
            alt={finalSection.imageSecondaryAlt}
            class="info-section__image info-section__image--final-right"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/section-scroll";
  </script>
</MainLayout>
