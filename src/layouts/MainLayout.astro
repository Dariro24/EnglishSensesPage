---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import siteContent from "../config/site.json";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  showFooter?: boolean;
  showFloatingWhatsApp?: boolean;
}

const {
  title = "English Senses",
  description = "Aprende inglés con English Senses mediante clases en vivo, acompañamiento cercano y experiencias prácticas para avanzar con confianza.",
  canonicalPath = Astro.url.pathname,
  robots = "index, follow",
  showFooter = true,
  showFloatingWhatsApp = true
} = Astro.props;

const favicon = siteContent.site.logo;
const siteUrl = Astro.site ?? new URL("https://www.englishsenses.com");
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={favicon} />
  </head>
  <body>
    <div class="site-app">
      <Header />

      <main class="page-wrap">
        <slot />
      </main>

      {showFooter && <Footer />}
      {showFloatingWhatsApp && <FloatingWhatsApp />}
    </div>
    <SpeedInsights />
  </body>
</html>
